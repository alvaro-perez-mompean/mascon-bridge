<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- HIDMaestro requires .NET 10 and Windows 10/11 x64 -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Exe, not WinExe, so the console modes keep their output. The console
         window is hidden when the graphical interface opens. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>mascon-bridge</AssemblyName>
    <RootNamespace>MasconBridge</RootNamespace>
    <!-- Release builds override this from the git tag: -p:Version=1.2.3. Kept in
         step with the last release so a local build does not claim to be older than
         it is: the window shows this, and the update check compares against it. -->
    <Version>0.2.2</Version>
    <Product>Mascon Bridge</Product>
    <Description>Maps an analogue axis on any joystick or lever to a virtual ZUIKI One Handle MasCon.</Description>
    <!-- WFO1000 wants every property of a control to say how a designer should
         serialise it. There is no designer here: the window is written by hand. -->
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
    <!-- Requests elevation: HIDMaestro needs admin to install and sign the driver -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Only these two ship. Without it the build drags in a satellite folder for
         every language the framework happens to be translated into. Keep in step
         with Language.Supported. -->
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>
    <!-- Committed because the build should not need Python and cairo.
         Regenerate from assets/icon.svg with: python assets/build-icon.py -->
    <ApplicationIcon>mascon-bridge.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- This project sits at the repository root, so its default glob would other-
         wise compile the test project's sources as well. -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy HIDMaestro.Core.dll here from the HIDMaestro release -->
    <Reference Include="HIDMaestro.Core">
      <HintPath>lib\HIDMaestro.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
